; ========================================
; Pyxel Frontend for Emulator (PFE)
; Example configuration
; ========================================
;
; Lines starting with ; or # are comments.
; Relative script paths are resolved from the PFE directory.
; Relative -DIR paths are resolved from ROM_BASE.

; ========================================
; Paths
; ========================================

; ROM_BASE: Base directory for ROMs.
; -DIR=nes becomes /roms/nes when ROM_BASE=/roms.
ROM_BASE=/roms

; SCREENSHOT_DIR: Base directory for ROM screenshots.
; PFE looks for images under SCREENSHOT_DIR/<system>/<rom-name>.png.
; Example: assets/screenshots/nes/Super Mario Bros.png
SCREENSHOT_DIR=assets/screenshots

; BGM_DIR: Directory containing background music files.
; Supported formats depend on the selected BGM driver, usually mp3/wav/ogg.
BGM_DIR=assets/bgm

; CORE_PATH: Optional RetroArch core directory.
; If set, PFE passes CORE_PATH/<core>_libretro.so to TYPE_RA.
; If omitted, PFE passes only the core filename and the launcher script can
; decide how to resolve it.
;CORE_PATH=/usr/lib/libretro

; ========================================
; Emulator / launcher scripts
; ========================================
; PFE delegates emulator startup to external scripts.

; RetroArch launcher.
; Receives: <core_path_or_filename> <rom_path>
TYPE_RA=./bin/retroarch.sh

; RA_LAUNCH_MODE:
; direct  -> bin/retroarch.sh tries retroarch directly first.
; runemu  -> bin/retroarch.sh delegates to ROCKNIX runemu.
; Leave direct for normal Linux/PC. Use runemu/rocknix only on ROCKNIX when needed.
;RA_LAUNCH_MODE=direct

; Standalone emulator launchers.
; Receives: <rom_path>
; Use these with -CORE=SA:NAME.
;TYPE_SA_PPSSPP=./bin/ppsspp.sh
;TYPE_SA_DRASTIC=./bin/drastic.sh
;TYPE_SA_YABASANSHIRO=./bin/yabasanshiro.sh

; Custom launcher types.
; Use these with -CORE=TYPE:NAME.
; Example: TYPE_PYXEL plus -CORE=pyxel:pyxel.
; bin/pyxel.sh is primarily used for ROCKNIX handoff launches. On normal Linux,
; edit that script or set its PYXEL_BIN/PFE_PYXEL_RUNNER environment variables
; if your pyxel executable is not in the default location.
TYPE_PYXEL=./bin/pyxel.sh

; RESUME_AFTER_GAME:
; true  -> keep PFE running and return quickly after emulator exit.
; false -> exit PFE after launching and let launcher.sh restart it.
RESUME_AFTER_GAME=true

; PYXEL_LAUNCH_MODE:
; handoff exits PFE while a Pyxel game runs. This avoids side-by-side windows
; on Wayland handheld systems such as ROCKNIX.
; direct keeps Pyxel launch synchronous inside the PFE process flow.
PYXEL_LAUNCH_MODE=handoff

; ========================================
; UI / image / font settings
; ========================================

; Splash screen duration in seconds.
; PFE shows assets/splash.png or assets/splash.jpg when present.
;SPLASH_TIME=3

; Text renderer backend: auto, bdf, ttf.
; auto prefers BDF when available, then falls back to TTF/pyxel-universal-font.
;FONT_BACKEND=auto

; Optional TrueType font path.
;FONT_PATH=assets/fonts/your-font.ttf

; Optional BDF pixel font path.
; If omitted, PFE tries Pyxel's bundled umplus_j10r.bdf.
;BDF_FONT_PATH=assets/fonts/umplus_j10r.bdf

; Optional 256-color .pyxpal palette.
; If omitted, PFE generates data/pfe_generated.pyxpal.
;PALETTE_FILE=data/pfe_generated.pyxpal

; Keep Pyxel's first 16 UI colors when applying a custom palette.
;PALETTE_PRESERVE_UI=true

; Gallery performance tuning.
; Lower scroll frames feel snappier on slower handhelds.
;GALLERY_SCROLL_FRAMES=8
;GALLERY_DEFER_IMAGE_LOAD=true
;GALLERY_POST_SCROLL_LOAD_DELAY=3
;GALLERY_PREFETCH=false

; ========================================
; Debug logging
; ========================================

DEBUG=false
;DEBUG_LEVEL=DEBUG
;DEBUG_LOG=data/debug.log
;DEBUG_CONSOLE=true

; ========================================
; Status display
; ========================================

; Top-right status flags.
;SHOW_TIME=true
;SHOW_CLOCK=true
;SHOW_BATTERY=true
;SHOW_NETWORK=true

; Network status cache interval in seconds.
NETWORK_CHECK_INTERVAL_SECONDS=60
;NETWORK_SCRIPT_LOG_INTERVAL_SECONDS=60

; ========================================
; WiFi scripts
; ========================================
; These are optional. If scripts are missing or unsuitable for your OS,
; replace them or use samples from scripts/samples/.

;WIFI_INTERFACE=wlan0
WIFI_SCAN_SCRIPT=./scripts/wifi_scan.sh
WIFI_SCAN_TIMEOUT=30
WIFI_SCAN_WAIT_SECONDS=6
WIFI_CONNECT_SCRIPT=./scripts/wifi_connect.sh
WIFI_STATUS_SCRIPT=./scripts/wifi_status.sh
WIFI_TOGGLE_SCRIPT=./scripts/wifi_toggle.sh

; ========================================
; Bluetooth scripts
; ========================================
; Optional. When not configured, the Bluetooth screen may fall back to
; bluetoothctl where available.

BT_SCAN_SCRIPT=./scripts/bt_scan.sh
BT_PAIR_SCRIPT=./scripts/bt_pair.sh
BT_STATUS_SCRIPT=./scripts/bt_status.sh
BT_TOGGLE_SCRIPT=./scripts/bt_toggle.sh

; ========================================
; System integration scripts
; ========================================

BATTERY_SCRIPT=./scripts/get_battery.sh
NETWORK_SCRIPT=./scripts/get_network.sh
CPU_GOVERNOR_GET_SCRIPT=./scripts/get_cpu_governor.sh
CPU_GOVERNOR_SET_SCRIPT=./scripts/set_cpu_governor.sh
DATETIME_SET_SCRIPT=./scripts/set_datetime.sh

REBOOT_SCRIPT=./scripts/system_reboot.sh
SHUTDOWN_SCRIPT=./scripts/system_shutdown.sh
RESTART_PFE_SCRIPT=./scripts/restart_pfe.sh
SWITCH_TO_ES_SCRIPT=./scripts/switch_to_es.sh

; ========================================
; Category definitions
; ========================================
; Each category defines a game system.
;
; Required:
; -TITLE: Display name
; -DIR: ROM directory, absolute or relative to ROM_BASE
; -EXT: Comma-separated extensions, without dots
; -CORE: Comma-separated cores/launchers
;
; Optional:
; -SYSTEM: EmulationStation/ROCKNIX system id, used for screenshot paths
; -TITLE_IMG: Category image shown in top gallery mode
;
; -CORE examples:
;   nestopia             -> RetroArch core through TYPE_RA
;   SA:PPSSPP            -> TYPE_SA_PPSSPP
;   pyxel:pyxel          -> TYPE_PYXEL
;
; RetroArch core conversion:
;   nestopia             -> nestopia_libretro.so
;   mupen64plus_next     -> mupen64plus_next_libretro.so
;   nestopia_libretro.so -> unchanged

; ========================================
; Pyxel apps
; ========================================
-TITLE=Pyxel
-SYSTEM=pyxel
-TITLE_IMG=./assets/title/pyxel.png
-DIR=pyxel
-EXT=py,pyxapp,edit
-CORE=pyxel:pyxel

; ========================================
; Nintendo Entertainment System
; ========================================
-TITLE=ファミコン
-SYSTEM=nes
-TITLE_IMG=./assets/title/Fc_Famicoin_b.png
-DIR=nes
-EXT=nes,unf,fds
-CORE=nestopia,fceumm

; ========================================
; Super Nintendo Entertainment System
; ========================================
-TITLE=スーファミ
-SYSTEM=snes
-TITLE_IMG=./assets/title/sfc@132w.png
-DIR=snes
-EXT=sfc,smc
-CORE=snes9x,bsnes

; ========================================
; Game Boy / Game Boy Color
; ========================================
-TITLE=Game Boy
-SYSTEM=gb
-TITLE_IMG=./assets/title/GBPocket_Green.png
-DIR=gb
-EXT=gb,gbc
-CORE=gambatte,sameboy

; ========================================
; Game Boy Advance
; ========================================
-TITLE=GBA
-SYSTEM=gba
-TITLE_IMG=./assets/title/GbaSp_Blue01.png
-DIR=gba
-EXT=gba
-CORE=mgba,vba_next

; ========================================
; Mega Drive / Genesis
; ========================================
-TITLE=メガドライブ
-SYSTEM=megadrive
-TITLE_IMG=./assets/title/MD.png
-DIR=megadrive
-EXT=md,bin,gen
-CORE=genesis_plus_gx,picodrive

; ========================================
; PlayStation
; ========================================
-TITLE=PlayStation
-SYSTEM=psx
-TITLE_IMG=./assets/title/Ps_disc1.png
-DIR=psx
-EXT=chd,bin,cue,pbp
-CORE=pcsx_rearmed

; ========================================
; PlayStation Portable
; ========================================
; Requires TYPE_SA_PPSSPP above.
;-TITLE=PSP
;-SYSTEM=psp
;-TITLE_IMG=./assets/title/PspGo_w01.png
;-DIR=psp
;-EXT=iso,cso,pbp
;-CORE=SA:PPSSPP

; ========================================
; Sega Saturn
; ========================================
; Example with both RetroArch and standalone launchers.
; Requires TYPE_SA_YABASANSHIRO above to enable SA:YABASANSHIRO.
;-TITLE=サターン
;-SYSTEM=saturn
;-TITLE_IMG=./assets/title/Ss_PowerMemoryb01.png
;-DIR=saturn
;-EXT=cue,bin,chd
;-CORE=yabasanshiro,SA:YABASANSHIRO

; ========================================
; Nintendo DS
; ========================================
; Requires TYPE_SA_DRASTIC above.
;-TITLE=Nintendo DS
;-SYSTEM=nds
;-TITLE_IMG=./assets/title/NintendoDSLite01.png
;-DIR=nds
;-EXT=nds,zip,7z
;-CORE=melonds,desmume,SA:DRASTIC
